{
  "name": "chatluna-plugin-impart",
  "version": "0.0.2",
  "description": "ChatLuna V2 群聊数值游戏，支持打胶、挖矿、排行榜与银趴开关，使用 Takumi 渲染图片",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Sor85/chatluna-plugin-impart.git" },
  "homepage": "https://github.com/Sor85/chatluna-plugin-impart#readme",
  "bugs": { "url": "https://github.com/Sor85/chatluna-plugin-impart/issues" },
  "keywords": ["chatluna-plugin", "impart", "takumi"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json",
    "./client": { "types": "./client/index.ts", "default": "./client/index.ts" }
  },
  "files": ["lib", "dist", "src", "client", "README.md", "LICENSE"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "sync": "node scripts/sync-to-v2.mjs --once",
    "build": "yakumo build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.2.8",
    "@takumi-rs/core": "1.8.7"
  },
  "peerDependencies": {
    "@chatluna/schema": ">=2.0.0-alpha.0",
    "@cordisjs/plugin-database": "4.2.0",
    "@satorijs/core": "~4.6.1",
    "cordis": "^4.0.0-rc.12"
  },
  "devDependencies": {
    "@chatluna/permission": "workspace:*",
    "@chatluna/schema": "workspace:*",
    "@chatluna/ui-client": "workspace:*",
    "@chatluna/ui-kit": "workspace:*",
    "@chatluna/ui-schema-form": "workspace:*",
    "@chatluna/ui-server": "workspace:*",
    "@cordisjs/plugin-database": "4.2.0",
    "@cordisjs/plugin-database-sqlite": "^5.2.0",
    "@satorijs/core": "~4.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cordis": "4.0.0-rc.12",
    "jsdom": "^31.0.0",
    "koishi": "npm:@koishijs/core@4.18.11",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  },
  "cordis": {
    "description": { "zh": "打胶、挖矿、排行榜与分群银趴开关", "en": "Group length game with training, mining, rankings and party controls" },
    "service": { "required": ["model", "database", "koishi", "permissions"], "optional": ["chatluna_webui"] }
  }
}
